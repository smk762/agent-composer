## Cloudflare Tunnel
# Create a tunnel in Cloudflare Zero Trust and paste the Docker token here.
CF_TUNNEL_TOKEN=REPLACE_ME

## Ingestion security (required)
# Shared secret used for request signing (HMAC) and (optionally) payload encryption (Fernet).
# Generate a strong random value and keep it private.
INGEST_SHARED_SECRET=REPLACE_ME

## Ingestion encryption (optional)
# Set to 1 to require encrypted envelopes: {"token":"..."}.
INGEST_REQUIRE_ENCRYPTION=0

## Ingestion replay protection (optional)
# Allowed clock skew window (seconds). Nonces are persisted to prevent replays within this window.
INGEST_MAX_SKEW_S=300

## Reload toggle (default on; set to 0 when using the cloud profile / prod)
APP_RELOAD=1

## Embeddings model (shared by ingest + chat retrieval)
EMBED_MODEL=nomic-embed-text

## Chat defaults (optional)
CHAT_MODEL=llama3.2:3b
CHAT_SYSTEM_PROMPT=You are a helpful assistant.

## Ollama runtime (optional)
OLLAMA_KEEP_ALIVE=15m
## Timeout in seconds for Ollama requests (increase for slow GPUs)
OLLAMA_TIMEOUT=300

## Logging (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=DEBUG

## Dev auth bypass (local only; disable in prod)
DEV_AUTH_BYPASS=0
DEV_DEFAULT_USER=dev@example.com

## Chat storage (API keys + history)
CHAT_DB_URL=sqlite:////data/chat.db
CHAT_HISTORY_MAX_MSGS=100

## Future: ingestion pipeline defaults (optional)
QDRANT_COLLECTION=project_docs

## Retrieval Augmented Generation (optional)
RAG_ENABLED=1
RAG_TOP_K=5
RAG_MAX_CONTEXT_CHARS=4000


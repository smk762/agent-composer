## Cloudflare Tunnel
# Create a tunnel in Cloudflare Zero Trust and paste the Docker token here.
CF_TUNNEL_TOKEN=REPLACE_ME

## Ingestion security (required)
# Shared secret used for request signing (HMAC) and (optionally) payload encryption (Fernet).
# Generate a strong random value and keep it private.
INGEST_SHARED_SECRET=REPLACE_ME

## Ingestion encryption (optional)
# Set to 1 to require encrypted envelopes: {"token":"..."}.
INGEST_REQUIRE_ENCRYPTION=0

## Ingestion replay protection (optional)
# Allowed clock skew window (seconds). Nonces are persisted to prevent replays within this window.
INGEST_MAX_SKEW_S=300

## Reload toggle (default on; set to 0 when using the cloud profile / prod)
APP_RELOAD=1

## Embeddings model (shared by ingest + chat retrieval)
EMBED_MODEL=nomic-embed-text

## Chat defaults (optional)
CHAT_MODEL=llama3.2:3b
CHAT_SYSTEM_PROMPT=You are a helpful assistant.

## Ollama runtime (optional)
OLLAMA_KEEP_ALIVE=15m
## Optional LAN exposure for Ollama via docker-compose.lan-ollama.yml
## Bind to a specific LAN IP, not 0.0.0.0. Example: 192.168.1.50
OLLAMA_BIND_IP=127.0.0.1
OLLAMA_PORT=11434
## Timeout in seconds for Ollama requests (increase for slow GPUs)
OLLAMA_TIMEOUT=300

## GPU (Docker): Ollama + Infinity request all GPUs via `gpus: all` in docker-compose.yml.
## Host requirements: NVIDIA driver + NVIDIA Container Toolkit
## https://docs.nvidia.com/datacenter/cloud-native/container-toolkit/install-guide.html
## After installing, restart Docker and run: docker run --rm --gpus all nvidia/cuda:12.0.0-base-ubuntu22.04 nvidia-smi
## Pin one GPU (e.g. RTX 4060 only): set to 0 or the GPU UUID.
# NVIDIA_VISIBLE_DEVICES=0

## Logging (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=DEBUG

## Dev auth bypass (local only; disable in prod)
DEV_AUTH_BYPASS=0
DEV_DEFAULT_USER=dev@example.com

## Chat storage (API keys + history)
# You can use either CHAT_DB_URL or DATABASE_URL.
# Plain "postgresql://" is accepted; app auto-normalizes to asyncpg.
# Examples:
# CHAT_DB_URL=postgresql://testuser:testpass@postgres:5432/testdb
# DATABASE_URL=postgresql://testuser:testpass@192.168.1.128:5432/testdb
CHAT_DB_URL=sqlite:////data/chat.db
DATABASE_URL=
CHAT_HISTORY_MAX_MSGS=100

## Vector DB endpoint + collection
## Defaults to the local qdrant container; override to point at an external host.
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=project_docs

## Qdrant port bindings (local only; not exposed to the internet)
QDRANT_BIND_IP=127.0.0.1
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

## Retrieval Augmented Generation (optional)
RAG_ENABLED=1
RAG_TOP_K=5
RAG_MAX_CONTEXT_CHARS=4000

## ---- Code-audit retrieval (optional) ----
## Set RETRIEVAL_PROFILE=code to chunk via tree-sitter (per function/class) and
## embed via the Infinity sidecar with a code-specialized model. The new
## collection layout uses named vectors (dense + optional sparse BM25) and a
## DIFFERENT collection name so the legacy text path stays untouched.
RETRIEVAL_PROFILE=text                       # text | code
EMBED_BACKEND=ollama                         # ollama | infinity
EMBED_BACKEND_URL=http://infinity:7997
EMBED_MODEL_CODE=nomic-ai/CodeRankEmbed
HYBRID_SPARSE=0                              # 1 = also store/query a BM25 sparse channel
QDRANT_COLLECTION_CODE=code_audit
RERANK_ENABLED=0
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_TOP_N=50

## Infinity (code embedder + reranker) port bindings.
## Bound to 127.0.0.1 by default so external services (e.g. the auditor) can
## reach it via host.docker.internal:7997 without exposing it to the LAN.
INFINITY_BIND_IP=127.0.0.1
INFINITY_PORT=7997
INFINITY_QUEUE_SIZE=512
## Infinity runs with `--device cuda` in compose; override visibility with NVIDIA_VISIBLE_DEVICES above.

## ---- Multimodal Generation ----

## Encryption key for provider API keys stored in the database.
## Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
## If unset, keys are stored as plaintext base64 (not recommended for prod).
PROVIDER_ENCRYPTION_KEY=

## Optional external ComfyUI URL (used only for generation endpoints targeting ComfyUI)
## Example: COMFYUI_URL=http://192.168.1.150:8188
COMFYUI_URL=

## GPU OOM wait/retry budget for local generation providers
## Requests will wait/retry on OOM until this budget is exhausted.
OOM_WAIT_MAX_SECONDS=180
OOM_WAIT_INTERVAL_SECONDS=5
## Worker concurrency controls (set to 1 to serialize GPU-heavy inference)
INFERENCE_WORKER_CONCURRENCY=1
INGEST_WORKER_CONCURRENCY=1

## Media storage directory (inside the container; mapped to rag_chat_media volume)
MEDIA_DIR=/data/media

## Optional MinIO/S3 media backend (set MEDIA_BACKEND=minio to enable)
MEDIA_BACKEND=local
MEDIA_S3_ENDPOINT_URL=
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=us-east-1
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_S3_USE_SSL=0
MEDIA_S3_PREFIX=rag-chat-media

## ---- Agentic repair pipeline ----
## URL of the ai-code-auditor audit API.  Used to run diff-audit validation
## between repair iterations.  Leave empty to disable inter-iteration validation.
AUDIT_API_URL=http://127.0.0.1:8765
## Path to the ai-code-auditor ecosystem.yaml on this host.
## Used to resolve repo paths for apply-in-place and compare-branch operations.
ECOSYSTEM_CONFIG_PATH=/home/smk/ai-code-auditor/config/ecosystem.yaml

## ---- ModernBERT — rag-chat pipeline proxy ----
## Internal Docker URL used by rag-chat to proxy /api/pipeline/* to the modernbert container.
MODERNBERT_URL=http://modernbert:7998

## ---- ModernBERT classifier sidecar ----
## Model from HuggingFace or local path.
MODERNBERT_MODEL=answerdotai/ModernBERT-base
## Task mode: zero_shot (cosine similarity; good for exploration) | classify (fine-tuned head)
MODERNBERT_TASK=zero_shot
## Device: auto (GPU if available, else CPU) | cuda | cpu
MODERNBERT_DEVICE=auto
## Comma-separated label set (or point MODERNBERT_LABELS_FILE at /data/labels.json)
MODERNBERT_LABELS=
MODERNBERT_LABELS_FILE=/data/labels.json
## How many top labels to return, and minimum score threshold
MODERNBERT_TOP_K=10
MODERNBERT_THRESHOLD=0.05
## Pooling strategy for zero_shot/embed: mean | cls
MODERNBERT_POOL=mean
## Set 1 to load model at startup rather than on first request
MODERNBERT_PRELOAD=0
## Keep-alive timers (seconds): how long to stay on GPU / CPU after last request.
## -1 = keep forever; 0 = evict/unload immediately after each request; N = idle timeout
MODERNBERT_KEEP_ALIVE_GPU=300
MODERNBERT_KEEP_ALIVE_CPU=0
## Port binding (loopback only by default)
MODERNBERT_BIND_IP=127.0.0.1
MODERNBERT_PORT=7998

## Optional Redis nonce store for ingest replay protection
## Keep sqlite for simple single-host setups.
INGEST_NONCE_STORE=sqlite
INGEST_REDIS_URL=
INGEST_NONCE_KEY_PREFIX=ingest:nonce:
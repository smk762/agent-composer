# syntax=docker/dockerfile:1
#
# faster-whisper STT image — GPU-accelerated via CTranslate2.
FROM python:3.12-slim

WORKDIR /app

# whisper_server decodes uploads with the ffmpeg CLI (not PyAV)
RUN apt-get update && \
    apt-get install -y --no-install-recommends ffmpeg && \
    rm -rf /var/lib/apt/lists/*

COPY requirements-whisper.txt .
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -r requirements-whisper.txt

# ctranslate2 dlopens cuBLAS/cuDNN; they come from the nvidia-*-cu12 wheels.
ENV LD_LIBRARY_PATH=/usr/local/lib/python3.12/site-packages/nvidia/cublas/lib:/usr/local/lib/python3.12/site-packages/nvidia/cudnn/lib

# Bake the model into the image so first request is fast.
# CTranslate2 downloads + converts on first load.
ARG STT_MODEL=large-v3-turbo
RUN python -c "from faster_whisper import WhisperModel; WhisperModel('${STT_MODEL}')"

COPY whisper_server.py .

EXPOSE 8030

ENV STT_MODEL=${STT_MODEL}
ENV STT_DEVICE=cuda
ENV STT_COMPUTE_TYPE=float16

CMD ["uvicorn", "whisper_server:app", "--host", "0.0.0.0", "--port", "8030"]

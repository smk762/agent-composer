## Hosts below are placeholders (<STATEFUL_HOST>, <AGENT_HOST>, <LAN_HOST>, ...).
## Put the real LAN host/IP in your local .env, never in this file.

## Cloudflare Tunnel
# Create a tunnel in Cloudflare Zero Trust and paste the Docker token here.
CF_TUNNEL_TOKEN=REPLACE_ME

## Ingestion security (required)
# Shared secret used for request signing (HMAC) and (optionally) payload encryption (Fernet).
# Generate a strong random value and keep it private.
INGEST_SHARED_SECRET=REPLACE_ME

## Ingestion encryption (optional)
# Set to 1 to require encrypted envelopes: {"token":"..."}.
INGEST_REQUIRE_ENCRYPTION=0

## Ingestion replay protection (optional)
# Allowed clock skew window (seconds). Nonces are persisted to prevent replays within this window.
INGEST_MAX_SKEW_S=300

## Reload toggle (default on; set to 0 when using the cloud profile / prod)
APP_RELOAD=1

## Embeddings model (shared by ingest + chat retrieval)
EMBED_MODEL=nomic-embed-text
## Task prefixes for the text embedder, shared by rag-ingest (chunks) and rag-chat (queries):
## none | nomic ("search_document: " / "search_query: "). Changing it changes the vector space:
## migrate the collection with `python -m app.reembed` (see docs/api.md) instead of flipping it.
EMBED_TASK_PREFIXES=none
## 1 = points without an `embedder` label also count as a mismatch (once a collection is fully labelled).
EMBEDDER_STRICT=0

## Chat defaults (optional)
CHAT_MODEL=llama3.2:3b
CHAT_SYSTEM_PROMPT=You are a helpful assistant.

## SingGuard content checks. /api/guard/check is a proxy to argus-retina's SingGuard
## server (image ghcr.io/smk762/argus-retina-singguard; container port 8080, host port
## 8134 in retina's compose), which holds the model, queues checks one at a time and
## takes its own GPU lease from argus-iris. Empty GUARD_URL: the route answers 503.
GUARD_URL=http://<GPU_HOST>:8134
## Seconds to wait for a check: slow and cascade take about 20 s on a 3090, plus queueing.
GUARD_TIMEOUT=120
## Sent when a check leaves thinking blank (retina's own default is fast).
## fast is the label and rule. fast-slow is the model's own reason after a
## first-line verdict. slow reasons first (no snap judgment). cascade runs
## fast, then slow only when fast flags the content.
GUARD_THINKING=fast-slow

## Default host bind address for published ports (rag-chat, rag-ingest, Ollama).
## Loopback by default; set a LAN IP (or 0.0.0.0) to reach them from other
## machines. A per-service <SERVICE>_BIND_IP (RAG_CHAT_BIND_IP, RAG_INGEST_BIND_IP,
## OLLAMA_BIND_IP) overrides it for that service only.
# BIND_ADDR=127.0.0.1

## Ollama runtime (optional)
## OLLAMA_KEEP_ALIVE is the Ollama daemon's default keep-alive (a duration such as 15m,
## or seconds; -1 = forever). Keep it a duration: Ollama silently reads anything else
## as its built-in 5m.
OLLAMA_KEEP_ALIVE=15m
## keep_alive that rag-chat and rag-ingest send with every Ollama request. Unset = the
## value of OLLAMA_KEEP_ALIVE. "server" sends none, so the daemon's default (and
## argus-iris, once it owns residency) decides how long models stay loaded.
# OLLAMA_REQUEST_KEEP_ALIVE=server

## argus-iris (GPU lease broker) resident contract. When set, the GPU sidecars
## (modernbert, infinity) require
## "Authorization: Bearer <token>" on POST /admin/{unload,evict,wake}, and
## rag-chat adds it itself when it calls /api/runtime/residents/<name>/admin/<action>,
## so set the same value for rag-chat and the sidecars (one shared value per suite).
## modernbert and infinity leave /admin/* open when the token is unset. The voice engines
## are argus-echo's residents, with echo's own token (#81).
##
## For argus-iris (broker on morpheus) to manage this host's GPU residents
## (gpu-tenant.yaml lists them):
##   1. Set ARGUS_ADMIN_TOKEN here to the suite's shared value.
##   2. Issue iris a rag-chat API key; the broker sends it as RAG_CHAT_API_KEY:
##        docker exec rag-chat python -m app.issue_api_key --user argus-iris --name "iris broker"
##   3. Put rag-chat (:9150) and Ollama (:11434) on the LAN: BIND_ADDR=<LAN IP>, or
##      RAG_CHAT_BIND_IP / OLLAMA_BIND_IP for just those two.
##   4. Once iris owns Ollama residency (its rollout step 4): OLLAMA_REQUEST_KEEP_ALIVE=server,
##      leaving OLLAMA_KEEP_ALIVE a duration. iris extends keep_alive per its policy and
##      holds pinned models at -1.
## DEV_AUTH_BYPASS=1 lets header-less requests through as the dev user, so with it
## set the gateway (and every other auth-gated route) is open to whoever can reach
## rag-chat. Turn it off on a LAN-bound rag-chat.
# ARGUS_ADMIN_TOKEN=
## Extra GPU sidecars the gateway serves without making them TTS engines, as
## name=url pairs. Empty by default.
# RUNTIME_EXTRA_RESIDENTS=name=http://<host>:<port>

## argus-iris GPU leases around Ollama calls (rag-chat and rag-ingest, #48). Off by
## default. With the broker on, each Ollama call holds an ollama:<model> lease; a grant
## on ARGUS_GPU_HOME_NODE uses the local Ollama, one on another node (jarrah) that
## node's Ollama. A refused or timed-out lease is a 503 with Retry-After (never retried
## as an OOM); an unreachable or misconfigured broker falls back to local Ollama.
# ARGUS_GPU_COORDINATOR=broker
# ARGUS_GPU_BROKER_URL=http://<BROKER_HOST>:8120
## The suite's shared caller token (same value in the broker's .env).
# ARGUS_GPU_BROKER_TOKEN=
## Fallback when the broker is unreachable: none (default; local Ollama, ungated) or
## lease (a host flock, which serialises every Ollama call).
# ARGUS_GPU_BROKER_FALLBACK=none
## The node this stack runs on (compose default dragon). Pinned models stay on it.
# ARGUS_GPU_HOME_NODE=dragon
## Models never placed off the home node. Empty = EMBED_MODEL (query embeddings must match
## the collection); none = no pins.
# OLLAMA_LEASE_PINNED_MODELS=
## How long a call waits for a grant (seconds) before the 503.
# RAG_CHAT_GPU_LEASE_TIMEOUT_S=60
# RAG_INGEST_GPU_LEASE_TIMEOUT_S=300
## Declared VRAM per model (MiB, model or model-without-tag): the broker uses its learned
## p95 when larger. Defaults: nomic-embed-text 600, anything else 6000.
# OLLAMA_LEASE_VRAM_MB=qwen3:8b=6000
## The weights part of that footprint (MiB, Ollama /api/ps size_vram): iris skips it when
## the model is already loaded. Defaults: qwen3:8b 5300, nomic-embed-text 320.
# OLLAMA_LEASE_MODEL_MB=qwen3:8b=5300
## The Ollama URL for a node, if the broker's base_url for it doesn't resolve in the containers.
# OLLAMA_NODE_URLS=jarrah=http://<STATEFUL_HOST>:11434
## Optional LAN exposure for Ollama via docker-compose.lan-ollama.yml
## Bind to a specific LAN IP, not 0.0.0.0. Example: <LAN_HOST>
## Leave unset to follow BIND_ADDR (loopback by default); setting it here would
## override BIND_ADDR for Ollama only.
# OLLAMA_BIND_IP=<LAN_HOST>
OLLAMA_PORT=11434
## Timeout in seconds for Ollama requests (increase for slow GPUs)
OLLAMA_TIMEOUT=300

## GPU (Docker): Ollama + Infinity request all GPUs via `gpus: all` in docker-compose.yml.
## Host requirements: NVIDIA driver + NVIDIA Container Toolkit
## https://docs.nvidia.com/datacenter/cloud-native/container-toolkit/install-guide.html
## After installing, restart Docker and run: docker run --rm --gpus all nvidia/cuda:12.0.0-base-ubuntu22.04 nvidia-smi
## Pin one GPU (e.g. RTX 4060 only): set to 0 or the GPU UUID.
# NVIDIA_VISIBLE_DEVICES=0

## Logging (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=DEBUG

## Dev auth bypass (local only; disable in prod)
DEV_AUTH_BYPASS=0
DEV_DEFAULT_USER=dev@example.com
## Extra users the bypass may act as via X-Dev-User (comma-separated; empty = DEV_DEFAULT_USER only)
# DEV_AUTH_USERS=

## Cloudflare Access identity (rag-chat)
# rag-chat trusts a Cloudflare Access user only after verifying the Access JWT
# (Cf-Access-Jwt-Assertion header or CF_Authorization cookie) against the team's
# certs, the application AUD tag, issuer and expiry. Leave either empty and Access
# identity is refused (API keys / DEV_AUTH_BYPASS still work).
CF_ACCESS_TEAM_DOMAIN=          # e.g. myteam.cloudflareaccess.com
CF_ACCESS_AUD=                  # Application Audience (AUD) tag from the Access app

## Chat storage (API keys + history)
# You can use either CHAT_DB_URL or DATABASE_URL. CHAT_DB_URL wins if both are
# set in the process environment. Plain "postgresql://" is accepted; the app
# auto-normalizes to asyncpg. Postgres lives on the stateful node, not in this
# compose file. sqlite is the fallback only when neither var is set.
# CHAT_DB_URL=sqlite:////data/chat.db
DATABASE_URL=postgresql://ragchat:ragchat@<STATEFUL_HOST>:5432/ragchat
CHAT_HISTORY_MAX_MSGS=100

## Vector DB endpoint + collection
## Qdrant, Postgres and MinIO run on the stateful node (<STATEFUL_HOST>), not in
## this compose file. Point this at wherever Qdrant actually runs.
QDRANT_URL=http://<STATEFUL_HOST>:6333
# Text collection: rag-ingest's default write target and what /chat and /search retrieve from.
# audit_docs holds ai-code-auditor's wiki sections and agent packs.
QDRANT_COLLECTION=audit_docs
# Extra text collections signed ingest requests may also target (comma list)
INGEST_ALLOWED_COLLECTIONS=

## Retrieval Augmented Generation (optional)
RAG_ENABLED=1
RAG_TOP_K=5
RAG_MAX_CONTEXT_CHARS=4000

## ---- Code-audit retrieval (optional) ----
## Set RETRIEVAL_PROFILE=code to chunk via tree-sitter (per function/class) and
## embed via the Infinity sidecar with a code-specialized model. The new
## collection layout uses named vectors (dense + optional sparse BM25) and a
## DIFFERENT collection name so the legacy text path stays untouched.
RETRIEVAL_PROFILE=text                       # text | code
EMBED_BACKEND_URL=http://infinity:7997       # Infinity (code embedder); text always embeds via Ollama
EMBED_MODEL_CODE=nomic-ai/CodeRankEmbed
HYBRID_SPARSE=0                              # 1 = also store/query a BM25 sparse channel
QDRANT_COLLECTION_CODE=code_audit
RERANK_ENABLED=0
RERANK_MODEL=BAAI/bge-reranker-v2-m3      # only served if listed in INFINITY_MODEL_IDS (+1.26 GB VRAM)
RERANK_TOP_N=50

## Infinity (code embedder + reranker) port bindings.
## Bound to 127.0.0.1 by default so external services (e.g. the auditor) can
## reach it via host.docker.internal:7997 without exposing it to the LAN.
INFINITY_BIND_IP=127.0.0.1
INFINITY_PORT=7997
INFINITY_QUEUE_SIZE=512
## Models Infinity loads (default: EMBED_MODEL_CODE only) and extra CLI args. Batch size drives
## peak VRAM: CodeRankEmbed peaks at 1.3 GB with batch 8, 3.5 GB with batch 32 (4000-char chunks).
# INFINITY_MODEL_IDS=nomic-ai/CodeRankEmbed
# INFINITY_EXTRA_ARGS=--batch-size 8
## Infinity manager eviction policy. It proxies Infinity, evicts the child
## process after this many idle seconds, and starts it again on the next request.
## Set -1 to keep resident forever, 0 to evict immediately after each request.
INFINITY_IDLE_TIMEOUT=900
INFINITY_PRELOAD=1
INFINITY_STARTUP_TIMEOUT=180
INFINITY_REQUEST_TIMEOUT=300
## Infinity runs with `--device cuda` in compose; override visibility with NVIDIA_VISIBLE_DEVICES above.

## ---- Multimodal Generation ----

## Encryption key for provider API keys stored in the database.
## Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
## If unset, saving a provider key is refused (keys saved earlier as base64 stay readable).
PROVIDER_ENCRYPTION_KEY=
## Without PROVIDER_ENCRYPTION_KEY, saving a provider key is refused; =1 allows plaintext (dev only)
# ALLOW_PLAINTEXT_PROVIDER_KEYS=

## Optional external ComfyUI URL (used only for generation endpoints targeting ComfyUI)
## Example: COMFYUI_URL=http://<COMFYUI_HOST>:8188
COMFYUI_URL=

## GPU OOM wait/retry budget for local generation providers
## Requests will wait/retry on OOM until this budget is exhausted.
OOM_WAIT_MAX_SECONDS=180
OOM_WAIT_INTERVAL_SECONDS=5
## Worker concurrency controls (set to 1 to serialize GPU-heavy inference)
INFERENCE_WORKER_CONCURRENCY=1
## Largest image/mask/first-frame upload /api/edit/image and /api/generate/video accept (bytes); bigger is a 413.
GENERATION_UPLOAD_MAX_BYTES=26214400
INGEST_WORKER_CONCURRENCY=1

## Media storage directory (inside the container; mapped to rag_chat_media volume)
MEDIA_DIR=/data/media

## Optional MinIO/S3 media backend (set MEDIA_BACKEND=minio to enable).
## MinIO runs on the stateful node, so point MEDIA_S3_ENDPOINT_URL at
## http://<STATEFUL_HOST>:9000 (or wherever your MinIO is reachable from rag-chat).
MEDIA_BACKEND=local
MEDIA_S3_ENDPOINT_URL=
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=us-east-1
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_S3_USE_SSL=0
MEDIA_S3_PREFIX=rag-chat-media

## ---- Agentic repair pipeline ----
## URL of the ai-code-auditor audit API.  Used to run diff-audit validation
## between repair iterations.  Leave empty to disable inter-iteration validation.
AUDIT_API_URL=http://127.0.0.1:8765
## Path to the ai-code-auditor ecosystem.yaml on this host.
## Used to resolve repo paths for apply-in-place and compare-branch operations.
ECOSYSTEM_CONFIG_PATH=/home/smk/ai-code-auditor/config/ecosystem.yaml
## Agent packs: repairs sent with "pack_id" fetch GET {base}/audit/packs/{id} for context.
## Base = request "audit_api_base", else AI_AUDIT_PUBLIC_BASE_URL, else AUDIT_API_URL.
# AI_AUDIT_PUBLIC_BASE_URL=http://<AUDIT_HOST>:8765
# AUDIT_PACK_TIMEOUT_S=10
## Repair requests may only send audit_api_url / audit_api_base to the origins above, plus
## these (comma-separated host or host:port; no wildcard, * is ignored; link-local hosts never).
# AUDIT_API_ALLOWED_HOSTS=
## After a clean applied auto_fix, POST /audit/packs/{id}/status resolved (fails soft). 0 disables.
# REPAIR_PACK_STATUS_CALLBACK=1
## X-API-Token for the audit API's mutating routes (same value as AI_AUDIT_API_TOKEN there).
# AI_AUDIT_API_TOKEN=

## ---- ModernBERT — rag-chat pipeline proxy ----
## Internal Docker URL used by rag-chat to proxy /api/pipeline/* to the modernbert container.
MODERNBERT_URL=http://modernbert:7998

## ---- ModernBERT classifier sidecar ----
## Model from HuggingFace or local path.
MODERNBERT_MODEL=answerdotai/ModernBERT-base
## Task mode: zero_shot (cosine similarity; good for exploration) | classify (fine-tuned head)
MODERNBERT_TASK=zero_shot
## Device: auto (GPU if available, else CPU) | cuda | cpu
MODERNBERT_DEVICE=auto
## Comma-separated label set (or point MODERNBERT_LABELS_FILE at /data/labels.json)
MODERNBERT_LABELS=
MODERNBERT_LABELS_FILE=/data/labels.json
## How many top labels to return, and minimum score threshold
MODERNBERT_TOP_K=10
MODERNBERT_THRESHOLD=0.05
## Pooling strategy for zero_shot/embed: mean | cls
MODERNBERT_POOL=mean
## Set 1 to load model at startup rather than on first request
MODERNBERT_PRELOAD=0
## Keep-alive timers (seconds): how long to stay on GPU / CPU after last request.
## -1 = keep forever; 0 = evict/unload immediately after each request; N = idle timeout.
## The CPU timer also runs after an /admin/evict, even with MODERNBERT_KEEP_ALIVE_GPU=-1.
MODERNBERT_KEEP_ALIVE_GPU=300
MODERNBERT_KEEP_ALIVE_CPU=0
## Port binding (loopback only by default)
MODERNBERT_BIND_IP=127.0.0.1
MODERNBERT_PORT=7998

## ---- Voice (proxied to argus-echo) ----
## Composer runs no voice engines (voice.md, #81): argus-echo runs Whisper, XTTS,
## Qwen, Miso and the Wyoming bridges from its own compose, and owns their settings.
## rag-chat proxies /api/voice/* to the engines named here; use LAN addresses
## (containers can't resolve bare hostnames). Empty disables that engine.
## TTS is a *registry* of interchangeable engines (all speak echo's tts contract);
## each is selectable per request in the UI / API, and one is default.
WHISPER_URL=http://<AGENT_HOST>:8144
XTTS_TTS_URL=http://<AGENT_HOST>:8141
MISO_TTS_URL=
## Which engine is used when a request doesn't specify one: xtts | miso | tts.
## Set to `miso` once MISO_TTS_URL is reachable to make Miso the default;
## keep `xtts` to make Miso opt-in (selectable but not default).
TTS_DEFAULT_ENGINE=xtts
## Fallback engine for default-path requests when the default engine is
## unreachable (e.g. the remote Miso host is down). Empty auto-selects xtts when
## the default isn't xtts — i.e. "prefer Miso, fall back to local XTTS" works
## out of the box once TTS_DEFAULT_ENGINE=miso. An explicitly selected engine is
## never silently switched.
TTS_FALLBACK_ENGINE=
## argus-iris leases for XTTS (#79). With ARGUS_GPU_COORDINATOR=broker every XTTS synth
## takes a lease on the `xtts` service target first. A grant on ARGUS_GPU_HOME_NODE calls
## XTTS_TTS_URL; a grant on another node calls that node's URL here (node=url,...), else
## the broker's base_url. A request naming a voice clone stays on the home node. When the
## lease is refused or times out, a default-path request moves to the next engine; on the
## last engine 1 runs it on the local XTTS CPU (slower than realtime on most CPUs), 0
## answers 503 with the broker's reason. VRAM figures are what the lease declares (MiB).
# XTTS_NODE_URLS=morpheus=http://<GPU_HOST>:8141
# XTTS_LEASE_CPU_FALLBACK=1
# XTTS_LEASE_VRAM_MB=2000
# XTTS_LEASE_MODEL_MB=1800
## Optional custom engine: a URL that isn't one of the engines above is registered
## as its own engine ("tts"), e.g. echo's Qwen at http://<AGENT_HOST>:8142.
TTS_URL=
## Timeout in seconds for voice proxy requests (STT + TTS).
## A single TTS synthesis can take tens of seconds, so keep this generous.
VOICE_TIMEOUT=180
## Reference clips per clone/analyze request, and bytes per clip (buffered in memory); more is a 413.
VOICE_MAX_CLIPS=16
VOICE_CLIP_MAX_BYTES=16777216

## MinIO/S3. MinIO runs on the stateful node (<STATEFUL_HOST>), not in this compose
## file. rag-chat uploads re-hosted and stitched audio to S3_BUCKET_NAME and hands
## browsers S3_PUBLIC_URL; minio-setup creates the bucket. Audio echo serves from its
## own buckets on the same MinIO is passed through as is.
S3_ENDPOINT_URL=http://<STATEFUL_HOST>:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=voice
S3_PUBLIC_URL=http://<STATEFUL_HOST>:9000/voice

## Optional Redis nonce store for ingest replay protection
## Keep sqlite for simple single-host setups.
INGEST_NONCE_STORE=sqlite
INGEST_REDIS_URL=
INGEST_NONCE_KEY_PREFIX=ingest:nonce:
## Redis down: ingest answers 503 until it is back. 1 = fall back to node-local sqlite
## instead (single replica only: replicas then stop sharing nonces).
INGEST_NONCE_ALLOW_SQLITE_FALLBACK=0